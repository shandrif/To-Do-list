{
  "name": "stark-todo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "STARK.OS — sci-fi task tracker on Cloudflare Workers + D1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply stark-todo-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply stark-todo-db --local",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.10",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "wrangler": "4.42.0"
  }
}
